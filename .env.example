# Copy to .env and fill in, then load into your shell before a real API run:
#   set -a; source .env; set +a
# .env is git-ignored. Never commit real keys.
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (official OpenAI, internal gateway, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
# Pinned model id for reproducibility, e.g. gpt-4o-mini-2024-07-18
OPENAI_MODEL=
# Optional. Leave unset/empty to send temperature=0 (default). Set to "omit"
# when the provider rejects temperature=0 and only accepts its server default;
# the run metadata then records "omitted (provider server default)" honestly.
# A numeric value (e.g. 0.7) is sent as-is.
# OPENAI_TEMPERATURE=omit
